# Salin file ini menjadi .env lalu isi dengan kredensial project Supabase Anda.
# Supabase Dashboard → Project Settings → API Keys (atau output `supabase start` untuk lokal).
# Setelah mengubah .env, hentikan lalu jalankan ulang `pnpm dev`.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx
# Project lama yang masih memakai anon key (JWT) boleh memakai nama ini:
# VITE_SUPABASE_ANON_KEY=
